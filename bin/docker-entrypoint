#!/usr/bin/env bash
set -e

npm install

echo "waiting for database to be ready…"
ATTEMPTS=0
until ./node_modules/.bin/prisma migrate deploy; do
  ATTEMPTS=$((ATTEMPTS+1))
  if [ $ATTEMPTS -gt 30 ]; then
    echo "prisma migrate deploy never succeeded against the database" >&2
    exit 1
  fi
  echo "migrate deploy failed, database likely not ready yet — retrying ($ATTEMPTS/30)…"
  sleep 1
done

./node_modules/.bin/prisma generate
npm run db:seed

exec "$@"
